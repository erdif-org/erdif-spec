{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://erdif-org.github.io/erdif-spec/schema/v1/common.schema.json",
  "title": "ERDIF common definitions",
  "description": "Shared value types referenced by the class schemas: language maps and the schema.org types reused as ranges.",
  "$defs": {
    "languageMap": {
      "description": "Human-readable text keyed by ISO 639-1 language code.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z]{2}$" },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "QuantitativeValue": {
      "description": "schema:QuantitativeValue — a number with a UN/CEFACT Recommendation 20 unit code.",
      "type": "object",
      "required": ["value", "unitCode"],
      "properties": {
        "@type": { "const": "QuantitativeValue" },
        "value": { "type": "number", "minimum": 0 },
        "unitCode": { "type": "string", "pattern": "^[A-Z0-9]{2,3}$" }
      }
    },
    "GeoCoordinates": {
      "description": "schema:GeoCoordinates — a WGS 84 point.",
      "type": "object",
      "required": ["latitude", "longitude"],
      "properties": {
        "@type": { "const": "GeoCoordinates" },
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    },
    "PostalAddress": {
      "description": "schema:PostalAddress — the postal address in the local format.",
      "type": "object",
      "properties": {
        "@type": { "const": "PostalAddress" },
        "streetAddress": { "type": "string", "minLength": 1 },
        "addressLocality": { "type": "string", "minLength": 1 },
        "addressRegion": { "type": "string", "minLength": 1 },
        "postalCode": { "type": "string", "minLength": 1 },
        "addressCountry": { "type": "string", "pattern": "^[A-Z]{2}$" }
      }
    }
  }
}
