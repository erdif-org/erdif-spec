# ERDIF vocabulary (RDFS/OWL)
# Generated by scripts/build_vocabulary.py from schema/terms/, codelists/
# and schema/common.schema.json. Do not edit by hand.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix schema: <https://schema.org/> .
@prefix erdif: <https://erdif-org.github.io/erdif-spec/ns/v1#> .
@prefix erdif-cl: <https://erdif-org.github.io/erdif-spec/codelist/v1/> .

<https://erdif-org.github.io/erdif-spec/ns/v1>
    a owl:Ontology ;
    rdfs:label "ERDIF - European Real Estate Data Interchange Format"@en, "ERDIF - Evropský formát pro výměnu realitních dat"@cs ;
    rdfs:comment "Vocabulary of the European Real Estate Data Interchange Format: the classes, properties and codelists used by ERDIF documents."@en, "Slovník Evropského formátu pro výměnu realitních dat: třídy, vlastnosti a číselníky používané dokumenty ERDIF."@cs ;
    owl:versionInfo "v1" ;
    rdfs:seeAlso <https://erdif-org.github.io/erdif-spec/ns/v1/context.jsonld> .

# --- Classes ---

erdif:Advert
    a owl:Class ;
    rdfs:label "Advert"@en ;
    rdfs:comment "Root entity of the format. Represents a single real estate offer."@en, "Kořenová entita formátu. Reprezentuje jednu nabídku nemovitosti."@cs ;
    rdfs:subClassOf schema:RealEstateListing ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:Price
    a owl:Class ;
    rdfs:label "Price"@en ;
    rdfs:comment "A single price item of the offer. An offer may carry several of different types."@en, "Jedna cenová položka nabídky. Nabídka jich může nést více různých typů."@cs ;
    rdfs:subClassOf schema:PriceSpecification ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:Contact
    a owl:Class ;
    rdfs:label "Contact"@en ;
    rdfs:comment "Contact entity of the offer. Kept separate from property data so personal data can be removed or anonymised independently."@en, "Kontaktní subjekt nabídky. Oddělen od dat nemovitosti, aby bylo možné osobní údaje samostatně odstranit nebo anonymizovat."@cs ;
    rdfs:seeAlso schema:Person, schema:Organization ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:Realty
    a owl:Class ;
    rdfs:label "Realty"@en ;
    rdfs:comment "The physical property. Kept separate from the commercial part because its description is independent of how it is currently advertised."@en, "Fyzická nemovitost. Oddělena od obchodní části, protože její popis je nezávislý na tom, jak je právě inzerována."@cs ;
    rdfs:subClassOf schema:Accommodation ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:Building
    a owl:Class ;
    rdfs:label "Building"@en ;
    rdfs:comment "The building the property belongs to. Its attributes are shared by all units in the building, so they are kept apart from the unit itself."@en, "Budova, ke které nemovitost patří. Její vlastnosti sdílejí všechny jednotky v budově, proto jsou oddělené od samotné jednotky."@cs ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:Location
    a owl:Class ;
    rdfs:label "Location"@en ;
    rdfs:comment "Location of the property combining three independent means of identification."@en, "Poloha nemovitosti kombinující tři nezávislé způsoby identifikace."@cs ;
    rdfs:subClassOf schema:Place ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:InspireIdentifier
    a owl:Class ;
    rdfs:label "InspireIdentifier"@en ;
    rdfs:comment "Supranational INSPIRE identifier of a spatial object (address, building or cadastral parcel)."@en, "Nadnárodní identifikátor prostorového objektu INSPIRE (adresní místo, budova nebo parcela)."@cs ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:LocalIdentifier
    a owl:Class ;
    rdfs:label "LocalIdentifier"@en ;
    rdfs:comment "Identifier from a national registry. Passed through unchanged for verification in local registries."@en, "Identifikátor z národního registru. Předává se beze změny pro ověření v lokálních registrech."@cs ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:LocalArea
    a owl:Class ;
    rdfs:label "LocalArea"@en ;
    rdfs:comment "An amenity in the surroundings of the property. Kept separate from `Location`, because it is descriptive information, not spatial identification."@en, "Prvek občanské vybavenosti v okolí nemovitosti. Oddělen od `Location`, protože jde o popisnou informaci, ne o prostorovou identifikaci."@cs ;
    rdfs:subClassOf schema:Place ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:Room
    a owl:Class ;
    rdfs:label "Room"@en ;
    rdfs:comment "A room of the property. Layout and total usable area can be derived from rooms."@en, "Místnost nemovitosti. Z místností lze odvodit dispozici i celkovou užitnou plochu."@cs ;
    rdfs:subClassOf schema:Room ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:Equipment
    a owl:Class ;
    rdfs:label "Equipment"@en ;
    rdfs:comment "An item of equipment bound to a specific room."@en, "Prvek vybavení vázaný na konkrétní místnost."@cs ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:UtilityNetwork
    a owl:Class ;
    rdfs:label "UtilityNetwork"@en ;
    rdfs:comment "Connection of the property to a utility network. Network and connection are two independent axes, hence two codelists."@en, "Napojení nemovitosti na inženýrskou síť. Síť a způsob připojení jsou dvě nezávislé osy, proto dva číselníky."@cs ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:Parking
    a owl:Class ;
    rdfs:label "Parking"@en ;
    rdfs:comment "A parking option belonging to the property. Not modelled as a room, because parking does not count towards the layout or usable area of the unit."@en, "Možnost parkování náležející k nemovitosti. Není modelována jako místnost, protože parkování se nezapočítává do dispozice ani užitné plochy jednotky."@cs ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:Media
    a owl:Class ;
    rdfs:label "Media"@en ;
    rdfs:comment "A multimedia item of the offer, including display order."@en, "Multimediální prvek nabídky včetně pořadí zobrazení."@cs ;
    rdfs:subClassOf schema:MediaObject ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:ExportInformation
    a owl:Class ;
    rdfs:label "ExportInformation"@en ;
    rdfs:comment "Audit trail enabling record matching on repeated import across systems."@en, "Auditní stopa umožňující párování záznamů při opakovaném importu napříč systémy."@cs ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

# --- schema.org classes referred to by the vocabulary ---

schema:RealEstateListing
    a owl:Class ;
    rdfs:label "RealEstateListing"@en ;
    rdfs:comment "A listing that describes one or more real-estate offerings."@en ;
    rdfs:isDefinedBy <https://schema.org/> .

schema:Accommodation
    a owl:Class ;
    rdfs:label "Accommodation"@en ;
    rdfs:comment "A place that can accommodate human beings, e.g. an apartment or a house."@en ;
    rdfs:isDefinedBy <https://schema.org/> .

schema:Place
    a owl:Class ;
    rdfs:label "Place"@en ;
    rdfs:comment "Entities that have a somewhat fixed, physical extension."@en ;
    rdfs:isDefinedBy <https://schema.org/> .

schema:Room
    a owl:Class ;
    rdfs:label "Room"@en ;
    rdfs:comment "A room is a distinguishable space within a structure."@en ;
    rdfs:isDefinedBy <https://schema.org/> .

schema:MediaObject
    a owl:Class ;
    rdfs:label "MediaObject"@en ;
    rdfs:comment "A media object, such as an image, video or audio object."@en ;
    rdfs:isDefinedBy <https://schema.org/> .

schema:PriceSpecification
    a owl:Class ;
    rdfs:label "PriceSpecification"@en ;
    rdfs:comment "A structured value representing a price or price range."@en ;
    rdfs:isDefinedBy <https://schema.org/> .

schema:Person
    a owl:Class ;
    rdfs:label "Person"@en ;
    rdfs:comment "A person (alive, dead, undead, or fictional)."@en ;
    rdfs:isDefinedBy <https://schema.org/> .

schema:Organization
    a owl:Class ;
    rdfs:label "Organization"@en ;
    rdfs:comment "An organization such as a school, NGO, corporation, club, etc."@en ;
    rdfs:isDefinedBy <https://schema.org/> .

schema:QuantitativeValue
    a owl:Class ;
    rdfs:label "QuantitativeValue"@en ;
    rdfs:comment "schema:QuantitativeValue — a number with a UN/CEFACT Recommendation 20 unit code."@en ;
    rdfs:isDefinedBy <https://schema.org/> .

schema:GeoCoordinates
    a owl:Class ;
    rdfs:label "GeoCoordinates"@en ;
    rdfs:comment "schema:GeoCoordinates — a WGS 84 point."@en ;
    rdfs:isDefinedBy <https://schema.org/> .

schema:PostalAddress
    a owl:Class ;
    rdfs:label "PostalAddress"@en ;
    rdfs:comment "schema:PostalAddress — the postal address in the local format."@en ;
    rdfs:isDefinedBy <https://schema.org/> .

# --- erdif: properties ---

erdif:accessibility
    a owl:ObjectProperty ;
    rdfs:label "accessibility"@en ;
    rdfs:comment "Realty: Accessibility features of the property as a whole (entrance, access). Room: Accessibility features of the room."@en, "Realty: Prvky bezbariérovosti nemovitosti jako celku (vstup, přístup). Room: Prvky bezbariérovosti místnosti."@cs ;
    schema:domainIncludes erdif:Realty, erdif:Room ;
    rdfs:range erdif-cl:AccessibilityFeature ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:amenityType
    a owl:ObjectProperty ;
    rdfs:label "amenityType"@en ;
    rdfs:comment "Type of amenity."@en, "Druh vybavenosti."@cs ;
    rdfs:domain erdif:LocalArea ;
    rdfs:range erdif-cl:AmenityType ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:approximateCoordinates
    a owl:DatatypeProperty ;
    rdfs:label "approximateCoordinates"@en ;
    rdfs:comment "Flag indicating whether coordinates are approximate."@en, "Příznak, zda jsou souřadnice přibližné."@cs ;
    rdfs:domain erdif:Location ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:building
    a owl:ObjectProperty ;
    rdfs:label "building"@en ;
    rdfs:comment "Building the property is part of or consists of. Omitted for land."@en, "Budova, jejíž je nemovitost součástí nebo kterou tvoří. U pozemků se neuvádí."@cs ;
    rdfs:domain erdif:Realty ;
    rdfs:range erdif:Building ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:condition
    a owl:ObjectProperty ;
    rdfs:label "condition"@en ;
    rdfs:comment "Condition of the property itself; may differ from the condition of the building."@en, "Stav samotné nemovitosti; může se lišit od stavu budovy."@cs ;
    rdfs:domain erdif:Realty ;
    rdfs:range erdif-cl:RealtyCondition ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:connection
    a owl:ObjectProperty ;
    rdfs:label "connection"@en ;
    rdfs:comment "Means of connection to the given network."@en, "Způsob napojení na danou síť."@cs ;
    rdfs:domain erdif:UtilityNetwork ;
    rdfs:range erdif-cl:UtilityConnection ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:constructionType
    a owl:ObjectProperty ;
    rdfs:label "constructionType"@en ;
    rdfs:comment "Main load-bearing construction of the building."@en, "Hlavní nosná konstrukce budovy."@cs ;
    rdfs:domain erdif:Building ;
    rdfs:range erdif-cl:ConstructionType ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:contact
    a owl:ObjectProperty ;
    rdfs:label "contact"@en ;
    rdfs:comment "Contact entity managing the offer."@en, "Kontaktní subjekt spravující nabídku."@cs ;
    rdfs:domain erdif:Advert ;
    rdfs:range erdif:Contact ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:contactType
    a owl:ObjectProperty ;
    rdfs:label "contactType"@en ;
    rdfs:comment "Type of advertiser (agent, office, owner)."@en, "Typ inzerenta (makléř, kancelář, majitel)."@cs ;
    rdfs:domain erdif:Contact ;
    rdfs:range erdif-cl:ContactType ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:count
    a owl:DatatypeProperty ;
    rdfs:label "count"@en ;
    rdfs:comment "Number of spaces of this type. Defaults to 1."@en, "Počet stání tohoto druhu. Výchozí hodnota je 1."@cs ;
    rdfs:domain erdif:Parking ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:distance
    a owl:ObjectProperty ;
    rdfs:label "distance"@en ;
    rdfs:comment "Distance from the property in metres (`MTR`)."@en, "Vzdálenost od nemovitosti v metrech (`MTR`)."@cs ;
    rdfs:domain erdif:LocalArea ;
    rdfs:range schema:QuantitativeValue ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:elevator
    a owl:DatatypeProperty ;
    rdfs:label "elevator"@en ;
    rdfs:comment "Flag indicating whether the building has an elevator."@en, "Příznak, zda je v budově výtah."@cs ;
    rdfs:domain erdif:Building ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:energyClass
    a owl:ObjectProperty ;
    rdfs:label "energyClass"@en ;
    rdfs:comment "Energy class per the EPBD directive."@en, "Energetická třída podle směrnice EPBD."@cs ;
    rdfs:domain erdif:Realty ;
    rdfs:range erdif-cl:EnergyClass ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:equipment
    a owl:ObjectProperty ;
    rdfs:label "equipment"@en ;
    rdfs:comment "Room equipment. Bound to the room, not the whole property."@en, "Vybavení místnosti. Vázáno na místnost, nikoli na celou nemovitost."@cs ;
    rdfs:domain erdif:Room ;
    rdfs:range erdif:Equipment ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:equipmentType
    a owl:ObjectProperty ;
    rdfs:label "equipmentType"@en ;
    rdfs:comment "Category of equipment."@en, "Kategorie vybavení."@cs ;
    rdfs:domain erdif:Equipment ;
    rdfs:range erdif-cl:EquipmentType ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:exportInformation
    a owl:ObjectProperty ;
    rdfs:label "exportInformation"@en ;
    rdfs:comment "Export audit trail."@en, "Auditní stopa exportu."@cs ;
    rdfs:domain erdif:Advert ;
    rdfs:range erdif:ExportInformation ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:exportedAt
    a owl:DatatypeProperty ;
    rdfs:label "exportedAt"@en ;
    rdfs:comment "Timestamp of the export."@en, "Časová značka exportu."@cs ;
    rdfs:domain erdif:ExportInformation ;
    rdfs:range xsd:dateTime ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:floorLevel
    a owl:DatatypeProperty ;
    rdfs:label "floorLevel"@en ;
    rdfs:comment "Realty: Floor on which the unit is located (0 = ground floor, negative = underground). Room: Floor the room is located on."@en, "Realty: Podlaží, ve kterém se jednotka nachází (0 = přízemí, záporné = podzemní). Room: Podlaží, na kterém se místnost nachází."@cs ;
    schema:domainIncludes erdif:Realty, erdif:Room ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:floorsAboveGround
    a owl:DatatypeProperty ;
    rdfs:label "floorsAboveGround"@en ;
    rdfs:comment "Number of above-ground floors including the ground floor."@en, "Počet nadzemních podlaží včetně přízemí."@cs ;
    rdfs:domain erdif:Building ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:floorsUnderground
    a owl:DatatypeProperty ;
    rdfs:label "floorsUnderground"@en ;
    rdfs:comment "Number of underground floors."@en, "Počet podzemních podlaží."@cs ;
    rdfs:domain erdif:Building ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:formatVersion
    a owl:DatatypeProperty ;
    rdfs:label "formatVersion"@en ;
    rdfs:comment "Version of the ERDIF format the document was created against."@en, "Verze formátu ERDIF, podle které byl dokument vytvořen."@cs ;
    rdfs:domain erdif:Advert ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:globalIdentifier
    a owl:ObjectProperty ;
    rdfs:label "globalIdentifier"@en ;
    rdfs:comment "Supranational INSPIRE spatial identifier."@en, "Nadnárodní prostorový identifikátor INSPIRE."@cs ;
    rdfs:domain erdif:Location ;
    rdfs:range erdif:InspireIdentifier ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:includedInPrice
    a owl:DatatypeProperty ;
    rdfs:label "includedInPrice"@en ;
    rdfs:comment "Flag indicating whether parking is included in the main price."@en, "Příznak, zda je parkování zahrnuto v hlavní ceně."@cs ;
    rdfs:domain erdif:Parking ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:inspireLocalId
    a owl:DatatypeProperty ;
    rdfs:label "localId"@en ;
    rdfs:comment "Identifier of the object within the namespace."@en, "Identifikátor objektu v rámci jmenného prostoru."@cs ;
    rdfs:domain erdif:InspireIdentifier ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:inspireNamespace
    a owl:DatatypeProperty ;
    rdfs:label "namespace"@en ;
    rdfs:comment "Namespace of the data provider (e.g. `CZ.CUZK.AD`)."@en, "Jmenný prostor poskytovatele dat (např. `CZ.CUZK.AD`)."@cs ;
    rdfs:domain erdif:InspireIdentifier ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:inspireTheme
    a owl:DatatypeProperty ;
    rdfs:label "theme"@en ;
    rdfs:comment "INSPIRE theme code: `AD` (addresses), `BU` (buildings), `CP` (cadastral parcels)."@en, "Kód tématu INSPIRE: `AD` (adresy), `BU` (budovy), `CP` (katastrální parcely)."@cs ;
    rdfs:domain erdif:InspireIdentifier ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:lastRenovationYear
    a owl:DatatypeProperty ;
    rdfs:label "lastRenovationYear"@en ;
    rdfs:comment "Year of the last major renovation of the building."@en, "Rok poslední rozsáhlé rekonstrukce budovy."@cs ;
    rdfs:domain erdif:Building ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:localArea
    a owl:ObjectProperty ;
    rdfs:label "localArea"@en ;
    rdfs:comment "Amenities in the surroundings of the property (transport, schools, parks, ...)."@en, "Občanská vybavenost v okolí nemovitosti (doprava, školy, parky, ...)."@cs ;
    rdfs:domain erdif:Realty ;
    rdfs:range erdif:LocalArea ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:localIdentifier
    a owl:ObjectProperty ;
    rdfs:label "localIdentifiers"@en ;
    rdfs:comment "National registry identifiers (e.g. RUIAN)."@en, "Identifikátory národních registrů (např. RÚIAN)."@cs ;
    rdfs:domain erdif:Location ;
    rdfs:range erdif:LocalIdentifier ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:location
    a owl:ObjectProperty ;
    rdfs:label "location"@en ;
    rdfs:comment "Location of the property."@en, "Poloha nemovitosti."@cs ;
    rdfs:domain erdif:Realty ;
    rdfs:range erdif:Location ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:media
    a owl:ObjectProperty ;
    rdfs:label "media"@en ;
    rdfs:comment "Photos, videos, floor plans and virtual tours."@en, "Fotografie, videa, půdorysy a virtuální prohlídky."@cs ;
    rdfs:domain erdif:Advert ;
    rdfs:range erdif:Media ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:mediaType
    a owl:ObjectProperty ;
    rdfs:label "mediaType"@en ;
    rdfs:comment "Type of media."@en, "Druh média."@cs ;
    rdfs:domain erdif:Media ;
    rdfs:range erdif-cl:MediaType ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:negotiable
    a owl:DatatypeProperty ;
    rdfs:label "negotiable"@en ;
    rdfs:comment "Flag indicating whether the price is negotiable."@en, "Příznak, zda je cena k jednání."@cs ;
    rdfs:domain erdif:Price ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:network
    a owl:ObjectProperty ;
    rdfs:label "network"@en ;
    rdfs:comment "Type of utility network."@en, "Druh inženýrské sítě."@cs ;
    rdfs:domain erdif:UtilityNetwork ;
    rdfs:range erdif-cl:UtilityNetwork ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:ownershipType
    a owl:ObjectProperty ;
    rdfs:label "ownershipType"@en ;
    rdfs:comment "Form of ownership."@en, "Forma vlastnictví."@cs ;
    rdfs:domain erdif:Realty ;
    rdfs:range erdif-cl:OwnershipType ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:parking
    a owl:ObjectProperty ;
    rdfs:label "parking"@en ;
    rdfs:comment "Parking options belonging to the property."@en, "Možnosti parkování náležející k nemovitosti."@cs ;
    rdfs:domain erdif:Realty ;
    rdfs:range erdif:Parking ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:parkingType
    a owl:ObjectProperty ;
    rdfs:label "parkingType"@en ;
    rdfs:comment "Type of parking."@en, "Druh parkování."@cs ;
    rdfs:domain erdif:Parking ;
    rdfs:range erdif-cl:ParkingType ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:plotSize
    a owl:ObjectProperty ;
    rdfs:label "plotSize"@en ;
    rdfs:comment "Area of the land plot in square metres (`MTK`)."@en, "Plocha pozemku v m² (`MTK`)."@cs ;
    rdfs:domain erdif:Realty ;
    rdfs:range schema:QuantitativeValue ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:position
    a owl:DatatypeProperty ;
    rdfs:label "position"@en ;
    rdfs:comment "Display order."@en, "Pořadí zobrazení."@cs ;
    rdfs:domain erdif:Media ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:price
    a owl:ObjectProperty ;
    rdfs:label "prices"@en ;
    rdfs:comment "Price items of the offer."@en, "Cenové položky nabídky."@cs ;
    rdfs:domain erdif:Advert ;
    rdfs:range erdif:Price ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:priceOnRequest
    a owl:DatatypeProperty ;
    rdfs:label "priceOnRequest"@en ;
    rdfs:comment "Flag indicating that the price is available on request only."@en, "Příznak, že cena je k dispozici pouze na dotaz."@cs ;
    rdfs:domain erdif:Price ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:priceType
    a owl:ObjectProperty ;
    rdfs:label "priceType"@en ;
    rdfs:comment "Type of the price item."@en, "Typ cenové položky."@cs ;
    rdfs:domain erdif:Price ;
    rdfs:range erdif-cl:PriceType ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:realty
    a owl:ObjectProperty ;
    rdfs:label "realty"@en ;
    rdfs:comment "Physical property the offer concerns."@en, "Fyzická nemovitost, které se nabídka týká."@cs ;
    rdfs:domain erdif:Advert ;
    rdfs:range erdif:Realty ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:realtyType
    a owl:ObjectProperty ;
    rdfs:label "realtyType"@en ;
    rdfs:comment "Type of real estate."@en, "Druh nemovitosti."@cs ;
    rdfs:domain erdif:Realty ;
    rdfs:range erdif-cl:RealtyType ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:registry
    a owl:DatatypeProperty ;
    rdfs:label "registry"@en ;
    rdfs:comment "Name of the registry (e.g. `RUIAN`)."@en, "Název registru (např. `RUIAN`)."@cs ;
    rdfs:domain erdif:LocalIdentifier ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:registryCountry
    a owl:DatatypeProperty ;
    rdfs:label "registryCountry"@en ;
    rdfs:comment "Country of the registry per ISO 3166-1 alpha-2."@en, "Země registru podle ISO 3166-1 alpha-2."@cs ;
    rdfs:domain erdif:LocalIdentifier ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:registryLevel
    a owl:DatatypeProperty ;
    rdfs:label "registryLevel"@en ;
    rdfs:comment "Level of the identified object within the registry (e.g. `Address`, `Building`, `Parcel`)."@en, "Úroveň identifikovaného objektu v registru (např. `Address`, `Building`, `Parcel`)."@cs ;
    rdfs:domain erdif:LocalIdentifier ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:room
    a owl:ObjectProperty ;
    rdfs:label "rooms"@en ;
    rdfs:comment "Breakdown into rooms. Land parcels have none."@en, "Členění nemovitosti na místnosti. Pozemky žádné nemají."@cs ;
    rdfs:domain erdif:Realty ;
    rdfs:range erdif:Room ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:roomType
    a owl:ObjectProperty ;
    rdfs:label "roomType"@en ;
    rdfs:comment "Type of room."@en, "Druh místnosti."@cs ;
    rdfs:domain erdif:Room ;
    rdfs:range erdif-cl:RoomType ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:sourceAdvertId
    a owl:DatatypeProperty ;
    rdfs:label "sourceAdvertId"@en ;
    rdfs:comment "Advert identifier within the source system."@en, "Identifikátor inzerátu ve zdrojovém systému."@cs ;
    rdfs:domain erdif:ExportInformation ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:sourceSystem
    a owl:DatatypeProperty ;
    rdfs:label "sourceSystem"@en ;
    rdfs:comment "Identification of the source software."@en, "Identifikace zdrojového softwaru."@cs ;
    rdfs:domain erdif:ExportInformation ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:transactionType
    a owl:ObjectProperty ;
    rdfs:label "transactionType"@en ;
    rdfs:comment "Type of transaction the offer concerns."@en, "Typ transakce, které se nabídka týká."@cs ;
    rdfs:domain erdif:Advert ;
    rdfs:range erdif-cl:TransactionType ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:utilityNetwork
    a owl:ObjectProperty ;
    rdfs:label "utilityNetworks"@en ;
    rdfs:comment "Utility network connections."@en, "Napojení na inženýrské sítě."@cs ;
    rdfs:domain erdif:Realty ;
    rdfs:range erdif:UtilityNetwork ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

# --- schema.org properties reused by ERDIF ---

schema:address
    a rdf:Property ;
    rdfs:label "address"@en ;
    rdfs:comment "Postal address in local format."@en, "Poštovní adresa v lokálním formátu."@cs ;
    schema:domainIncludes erdif:Location ;
    schema:rangeIncludes schema:PostalAddress ;
    rdfs:isDefinedBy <https://schema.org/> .

schema:addressCountry
    a rdf:Property ;
    rdfs:label "addressCountry"@en ;
    rdfs:comment "Country as a two-letter ISO 3166-1 code."@en, "Země jako dvoupísmenný kód ISO 3166-1."@cs ;
    schema:domainIncludes schema:PostalAddress ;
    schema:rangeIncludes xsd:string ;
    rdfs:isDefinedBy <https://schema.org/> .

schema:addressLocality
    a rdf:Property ;
    rdfs:label "addressLocality"@en ;
    rdfs:comment "Municipality or city."@en, "Obec nebo město."@cs ;
    schema:domainIncludes schema:PostalAddress ;
    schema:rangeIncludes xsd:string ;
    rdfs:isDefinedBy <https://schema.org/> .

schema:addressRegion
    a rdf:Property ;
    rdfs:label "addressRegion"@en ;
    rdfs:comment "Region, state or province."@en, "Kraj, region nebo provincie."@cs ;
    schema:domainIncludes schema:PostalAddress ;
    schema:rangeIncludes xsd:string ;
    rdfs:isDefinedBy <https://schema.org/> .

schema:caption
    a rdf:Property ;
    rdfs:label "caption"@en ;
    rdfs:comment "Caption of the media item in language variants."@en, "Popisek média v jazykových mutacích."@cs ;
    schema:domainIncludes erdif:Media ;
    schema:rangeIncludes rdf:langString ;
    rdfs:isDefinedBy <https://schema.org/> .

schema:contentUrl
    a rdf:Property ;
    rdfs:label "contentUrl"@en ;
    rdfs:comment "URL of the media item."@en, "Adresa média."@cs ;
    schema:domainIncludes erdif:Media ;
    schema:rangeIncludes xsd:anyURI ;
    rdfs:isDefinedBy <https://schema.org/> .

schema:datePosted
    a rdf:Property ;
    rdfs:label "datePosted"@en ;
    rdfs:comment "Moment the offer was published."@en, "Okamžik zveřejnění nabídky."@cs ;
    schema:domainIncludes erdif:Advert ;
    schema:rangeIncludes xsd:dateTime ;
    rdfs:isDefinedBy <https://schema.org/> .

schema:description
    a rdf:Property ;
    rdfs:label "description"@en ;
    rdfs:comment "Marketing text of the offer in language variants. At least one language is required."@en, "Marketingový text nabídky v jazykových mutacích. Alespoň jeden jazyk je povinný."@cs ;
    schema:domainIncludes erdif:Advert ;
    schema:rangeIncludes rdf:langString ;
    rdfs:isDefinedBy <https://schema.org/> .

schema:email
    a rdf:Property ;
    rdfs:label "email"@en ;
    rdfs:comment "Contact e-mail."@en, "Kontaktní e-mail."@cs ;
    schema:domainIncludes erdif:Contact ;
    schema:rangeIncludes xsd:string ;
    rdfs:isDefinedBy <https://schema.org/> .

schema:floorSize
    a rdf:Property ;
    rdfs:label "floorSize"@en ;
    rdfs:comment "Realty: Total floor area of the building or unit in square metres (`MTK`). Room: Room area in square metres."@en, "Realty: Celková podlahová plocha stavby nebo jednotky v m² (`MTK`). Room: Plocha místnosti v m²."@cs ;
    schema:domainIncludes erdif:Realty, erdif:Room ;
    schema:rangeIncludes schema:QuantitativeValue ;
    rdfs:isDefinedBy <https://schema.org/> .

schema:geo
    a rdf:Property ;
    rdfs:label "geo"@en ;
    rdfs:comment "WGS 84 coordinates. Mandatory fallback."@en, "Souřadnice WGS 84. Povinný záložní údaj."@cs ;
    schema:domainIncludes erdif:Location ;
    schema:rangeIncludes schema:GeoCoordinates ;
    rdfs:isDefinedBy <https://schema.org/> .

schema:identifier
    a rdf:Property ;
    rdfs:label "identifier"@en ;
    rdfs:comment "Advert: Identifier of the advert within the issuing system. LocalIdentifier: Identifier of the object in the registry."@en, "Advert: Identifikátor inzerátu v rámci vydávajícího systému. LocalIdentifier: Identifikátor objektu v registru."@cs ;
    schema:domainIncludes erdif:Advert, erdif:LocalIdentifier ;
    schema:rangeIncludes xsd:string ;
    rdfs:isDefinedBy <https://schema.org/> .

schema:latitude
    a rdf:Property ;
    rdfs:label "latitude"@en ;
    rdfs:comment "Latitude in WGS 84 decimal degrees."@en, "Zeměpisná šířka ve stupních WGS 84."@cs ;
    schema:domainIncludes schema:GeoCoordinates ;
    schema:rangeIncludes xsd:double ;
    rdfs:isDefinedBy <https://schema.org/> .

schema:longitude
    a rdf:Property ;
    rdfs:label "longitude"@en ;
    rdfs:comment "Longitude in WGS 84 decimal degrees."@en, "Zeměpisná délka ve stupních WGS 84."@cs ;
    schema:domainIncludes schema:GeoCoordinates ;
    schema:rangeIncludes xsd:double ;
    rdfs:isDefinedBy <https://schema.org/> .

schema:name
    a rdf:Property ;
    rdfs:label "name"@en ;
    rdfs:comment "Contact: Name of the entity. LocalArea: Name of the amenity. Equipment: Label of the equipment item."@en, "Contact: Jméno subjektu. LocalArea: Název místa. Equipment: Označení prvku vybavení."@cs ;
    schema:domainIncludes erdif:Contact, erdif:LocalArea, erdif:Equipment ;
    schema:rangeIncludes rdf:langString ;
    rdfs:isDefinedBy <https://schema.org/> .

schema:postalCode
    a rdf:Property ;
    rdfs:label "postalCode"@en ;
    rdfs:comment "Postal code."@en, "Poštovní směrovací číslo."@cs ;
    schema:domainIncludes schema:PostalAddress ;
    schema:rangeIncludes xsd:string ;
    rdfs:isDefinedBy <https://schema.org/> .

schema:price
    a rdf:Property ;
    rdfs:label "price"@en ;
    rdfs:comment "Numeric value of the price. May be omitted only when `priceOnRequest` is true."@en, "Číselná hodnota ceny. Smí chybět jen tehdy, když je `priceOnRequest` true."@cs ;
    schema:domainIncludes erdif:Price ;
    schema:rangeIncludes xsd:decimal ;
    rdfs:isDefinedBy <https://schema.org/> .

schema:priceCurrency
    a rdf:Property ;
    rdfs:label "priceCurrency"@en ;
    rdfs:comment "Currency per ISO 4217."@en, "Měna podle ISO 4217."@cs ;
    schema:domainIncludes erdif:Price ;
    schema:rangeIncludes xsd:string ;
    rdfs:isDefinedBy <https://schema.org/> .

schema:streetAddress
    a rdf:Property ;
    rdfs:label "streetAddress"@en ;
    rdfs:comment "Street and house number."@en, "Ulice a číslo domu."@cs ;
    schema:domainIncludes schema:PostalAddress ;
    schema:rangeIncludes xsd:string ;
    rdfs:isDefinedBy <https://schema.org/> .

schema:telephone
    a rdf:Property ;
    rdfs:label "telephone"@en ;
    rdfs:comment "Contact phone in international format."@en, "Kontaktní telefon v mezinárodním formátu."@cs ;
    schema:domainIncludes erdif:Contact ;
    schema:rangeIncludes xsd:string ;
    rdfs:isDefinedBy <https://schema.org/> .

schema:unitCode
    a rdf:Property ;
    rdfs:label "unitCode"@en ;
    rdfs:comment "Price: Unit of measure per UN/CEFACT (e.g. MON per month, MTK per sqm). QuantitativeValue: Unit of measure per UN/CEFACT Recommendation 20 (e.g. MTK for square metres)."@en, "Price: Měrná jednotka podle UN/CEFACT (např. MON za měsíc, MTK za m²). QuantitativeValue: Měrná jednotka podle UN/CEFACT Recommendation 20 (např. MTK pro m²)."@cs ;
    schema:domainIncludes erdif:Price, schema:QuantitativeValue ;
    schema:rangeIncludes xsd:string ;
    rdfs:isDefinedBy <https://schema.org/> .

schema:value
    a rdf:Property ;
    rdfs:label "value"@en ;
    rdfs:comment "The numeric value of the quantity."@en, "Číselná hodnota veličiny."@cs ;
    schema:domainIncludes schema:QuantitativeValue ;
    schema:rangeIncludes xsd:decimal ;
    rdfs:isDefinedBy <https://schema.org/> .

schema:yearBuilt
    a rdf:Property ;
    rdfs:label "yearBuilt"@en ;
    rdfs:comment "Year the building was completed."@en, "Rok dokončení budovy."@cs ;
    schema:domainIncludes erdif:Building ;
    schema:rangeIncludes xsd:integer ;
    rdfs:isDefinedBy <https://schema.org/> .

# --- Codelists ---

erdif-cl:AccessibilityFeature
    a owl:Class, skos:ConceptScheme ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "AccessibilityFeature"@en ;
    rdfs:comment "Accessibility feature. `appliesTo` lists the levels (Realty, Room) the value may be used on."@en, "Prvek bezbariérovosti. `appliesTo` uvádí úrovně (Realty, Room), na kterých lze hodnotu použít."@cs ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

<https://erdif-org.github.io/erdif-spec/codelist/v1/AccessibilityFeature#BarrierFree>
    a skos:Concept, erdif-cl:AccessibilityFeature ;
    skos:inScheme erdif-cl:AccessibilityFeature ;
    skos:notation "BarrierFree" ;
    skos:prefLabel "Barrier-free"@en, "Bezbariérová"@cs ;
    skos:definition "Fully accessible according to the national regulation (e.g. Decree 398/2009 Coll. in CZ)."@en, "Plně bezbariérová podle národního předpisu (v ČR vyhláška č. 398/2009 Sb.)."@cs .

<https://erdif-org.github.io/erdif-spec/codelist/v1/AccessibilityFeature#StepFreeEntrance>
    a skos:Concept, erdif-cl:AccessibilityFeature ;
    skos:inScheme erdif-cl:AccessibilityFeature ;
    skos:notation "StepFreeEntrance" ;
    skos:prefLabel "Step-free entrance"@en, "Bezbariérový vstup"@cs ;
    skos:definition "Entrance without steps or with a ramp."@en, "Vstup bez schodů nebo s rampou."@cs .

<https://erdif-org.github.io/erdif-spec/codelist/v1/AccessibilityFeature#ElevatorAccess>
    a skos:Concept, erdif-cl:AccessibilityFeature ;
    skos:inScheme erdif-cl:AccessibilityFeature ;
    skos:notation "ElevatorAccess" ;
    skos:prefLabel "Elevator access"@en, "Přístup výtahem"@cs ;
    skos:definition "The unit is reachable by an elevator."@en, "Jednotka je dosažitelná výtahem."@cs .

<https://erdif-org.github.io/erdif-spec/codelist/v1/AccessibilityFeature#StairLift>
    a skos:Concept, erdif-cl:AccessibilityFeature ;
    skos:inScheme erdif-cl:AccessibilityFeature ;
    skos:notation "StairLift" ;
    skos:prefLabel "Stair lift"@en, "Schodišťová plošina"@cs ;
    skos:definition "Stair lift or platform lift."@en, "Schodišťová nebo zdvižná plošina."@cs .

<https://erdif-org.github.io/erdif-spec/codelist/v1/AccessibilityFeature#WideDoorways>
    a skos:Concept, erdif-cl:AccessibilityFeature ;
    skos:inScheme erdif-cl:AccessibilityFeature ;
    skos:notation "WideDoorways" ;
    skos:prefLabel "Wide doorways"@en, "Rozšířené dveře"@cs ;
    skos:definition "Doorways wide enough for a wheelchair."@en, "Dveře dostatečně široké pro invalidní vozík."@cs .

<https://erdif-org.github.io/erdif-spec/codelist/v1/AccessibilityFeature#ThresholdFree>
    a skos:Concept, erdif-cl:AccessibilityFeature ;
    skos:inScheme erdif-cl:AccessibilityFeature ;
    skos:notation "ThresholdFree" ;
    skos:prefLabel "Threshold-free"@en, "Bez prahů"@cs ;
    skos:definition "No thresholds between rooms."@en, "Bez prahů mezi místnostmi."@cs .

<https://erdif-org.github.io/erdif-spec/codelist/v1/AccessibilityFeature#WheelchairTurningSpace>
    a skos:Concept, erdif-cl:AccessibilityFeature ;
    skos:inScheme erdif-cl:AccessibilityFeature ;
    skos:notation "WheelchairTurningSpace" ;
    skos:prefLabel "Wheelchair turning space"@en, "Otočný prostor pro vozík"@cs ;
    skos:definition "Enough space for a wheelchair to turn."@en, "Dostatečný prostor pro otočení invalidního vozíku."@cs .

<https://erdif-org.github.io/erdif-spec/codelist/v1/AccessibilityFeature#WalkInShower>
    a skos:Concept, erdif-cl:AccessibilityFeature ;
    skos:inScheme erdif-cl:AccessibilityFeature ;
    skos:notation "WalkInShower" ;
    skos:prefLabel "Walk-in shower"@en, "Bezbariérový sprchový kout"@cs ;
    skos:definition "Level-access shower without a tray edge."@en, "Sprchový kout bez vaničky a obruby."@cs .

<https://erdif-org.github.io/erdif-spec/codelist/v1/AccessibilityFeature#GrabBars>
    a skos:Concept, erdif-cl:AccessibilityFeature ;
    skos:inScheme erdif-cl:AccessibilityFeature ;
    skos:notation "GrabBars" ;
    skos:prefLabel "Grab bars"@en, "Madla"@cs ;
    skos:definition "Support grab bars at the toilet, bath or shower."@en, "Opěrná madla u WC, vany nebo sprchy."@cs .

erdif-cl:AmenityType
    a owl:Class, skos:ConceptScheme ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "AmenityType"@en ;
    rdfs:comment "Type of amenity in the surroundings of the property."@en, "Druh občanské vybavenosti v okolí nemovitosti."@cs ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

<https://erdif-org.github.io/erdif-spec/codelist/v1/AmenityType#BusStop>
    a skos:Concept, erdif-cl:AmenityType ;
    skos:inScheme erdif-cl:AmenityType ;
    skos:notation "BusStop" ;
    skos:prefLabel "Bus stop"@en, "Autobusová zastávka"@cs ;
    skos:definition "Public bus stop."@en, "Zastávka městské nebo linkové autobusové dopravy."@cs .

<https://erdif-org.github.io/erdif-spec/codelist/v1/AmenityType#TramStop>
    a skos:Concept, erdif-cl:AmenityType ;
    skos:inScheme erdif-cl:AmenityType ;
    skos:notation "TramStop" ;
    skos:prefLabel "Tram stop"@en, "Tramvajová zastávka"@cs ;
    skos:definition "Public tram stop."@en, "Zastávka tramvaje."@cs .

<https://erdif-org.github.io/erdif-spec/codelist/v1/AmenityType#MetroStation>
    a skos:Concept, erdif-cl:AmenityType ;
    skos:inScheme erdif-cl:AmenityType ;
    skos:notation "MetroStation" ;
    skos:prefLabel "Metro station"@en, "Stanice metra"@cs ;
    skos:definition "Underground or metro station."@en, "Stanice metra."@cs .

<https://erdif-org.github.io/erdif-spec/codelist/v1/AmenityType#TrainStation>
    a skos:Concept, erdif-cl:AmenityType ;
    skos:inScheme erdif-cl:AmenityType ;
    skos:notation "TrainStation" ;
    skos:prefLabel "Train station"@en, "Vlakové nádraží"@cs ;
    skos:definition "Railway station or stop."@en, "Železniční stanice nebo zastávka."@cs .

<https://erdif-org.github.io/erdif-spec/codelist/v1/AmenityType#ParkingLot>
    a skos:Concept, erdif-cl:AmenityType ;
    skos:inScheme erdif-cl:AmenityType ;
    skos:notation "ParkingLot" ;
    skos:prefLabel "Public parking"@en, "Veřejné parkoviště"@cs ;
    skos:definition "Public car park."@en, "Veřejné parkoviště."@cs .

<https://erdif-org.github.io/erdif-spec/codelist/v1/AmenityType#Kindergarten>
    a skos:Concept, erdif-cl:AmenityType ;
    skos:inScheme erdif-cl:AmenityType ;
    skos:notation "Kindergarten" ;
    skos:prefLabel "Kindergarten"@en, "Mateřská škola"@cs ;
