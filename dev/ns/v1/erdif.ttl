# ERDIF vocabulary — generated by scripts/build_vocabulary.py from
# schema/terms/*.json and codelists/*.json. Do not edit by hand.

@prefix erdif: <https://erdif-org.github.io/erdif-spec/ns/v1#> .
@prefix erdif-cl: <https://erdif-org.github.io/erdif-spec/codelist/v1/> .
@prefix schema: <https://schema.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://erdif-org.github.io/erdif-spec/ns/v1>
    a owl:Ontology ;
    rdfs:label "ERDIF vocabulary"@en, "Slovník ERDIF"@cs ;
    rdfs:comment "European Real Estate Data Interchange Format — classes and properties of the format."@en, "European Real Estate Data Interchange Format — třídy a vlastnosti formátu."@cs ;
    dcterms:source <https://erdif-org.github.io/erdif-spec/> ;
    owl:versionInfo "v1" .

#======================================================================
# Classes
#======================================================================

erdif:Advert
    a owl:Class ;
    rdfs:label "Advert"@en ;
    rdfs:comment "Kořenová entita formátu. Reprezentuje jednu nabídku nemovitosti."@cs, "Root entity of the format. Represents a single real estate offer."@en ;
    rdfs:subClassOf schema:RealEstateListing ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:Price
    a owl:Class ;
    rdfs:label "Price"@en ;
    rdfs:comment "Jedna cenová položka nabídky. Nabídka jich může nést více různých typů."@cs, "A single price item of the offer. An offer may carry several of different types."@en ;
    rdfs:subClassOf schema:PriceSpecification ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:Contact
    a owl:Class ;
    rdfs:label "Contact"@en ;
    rdfs:comment "Kontaktní subjekt nabídky. Oddělen od dat nemovitosti, aby bylo možné osobní údaje samostatně odstranit nebo anonymizovat."@cs, "Contact entity of the offer. Kept separate from property data so personal data can be removed or anonymised independently."@en ;
    rdfs:subClassOf schema:Thing ;
    rdfs:seeAlso schema:Person, schema:Organization ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:Realty
    a owl:Class ;
    rdfs:label "Realty"@en ;
    rdfs:comment "Fyzická nemovitost. Oddělena od obchodní části, protože její popis je nezávislý na tom, jak je právě inzerována."@cs, "The physical property. Kept separate from the commercial part because its description is independent of how it is currently advertised."@en ;
    rdfs:subClassOf schema:Accommodation ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:Building
    a owl:Class ;
    rdfs:label "Building"@en ;
    rdfs:comment "Budova, ke které nemovitost patří. Její vlastnosti sdílejí všechny jednotky v budově, proto jsou oddělené od samotné jednotky."@cs, "The building the property belongs to. Its attributes are shared by all units in the building, so they are kept apart from the unit itself."@en ;
    rdfs:subClassOf schema:Thing ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:Location
    a owl:Class ;
    rdfs:label "Location"@en ;
    rdfs:comment "Poloha nemovitosti kombinující tři nezávislé způsoby identifikace."@cs, "Location of the property combining three independent means of identification."@en ;
    rdfs:subClassOf schema:Place ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:InspireIdentifier
    a owl:Class ;
    rdfs:label "InspireIdentifier"@en ;
    rdfs:comment "Nadnárodní identifikátor prostorového objektu INSPIRE (adresní místo, budova nebo parcela)."@cs, "Supranational INSPIRE identifier of a spatial object (address, building or cadastral parcel)."@en ;
    rdfs:subClassOf schema:Thing ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:LocalIdentifier
    a owl:Class ;
    rdfs:label "LocalIdentifier"@en ;
    rdfs:comment "Identifikátor z národního registru. Předává se beze změny pro ověření v lokálních registrech."@cs, "Identifier from a national registry. Passed through unchanged for verification in local registries."@en ;
    rdfs:subClassOf schema:Thing ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:LocalArea
    a owl:Class ;
    rdfs:label "LocalArea"@en ;
    rdfs:comment "Prvek občanské vybavenosti v okolí nemovitosti. Oddělen od `Location`, protože jde o popisnou informaci, ne o prostorovou identifikaci."@cs, "An amenity in the surroundings of the property. Kept separate from `Location`, because it is descriptive information, not spatial identification."@en ;
    rdfs:subClassOf schema:Place ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:Room
    a owl:Class ;
    rdfs:label "Room"@en ;
    rdfs:comment "Místnost nemovitosti. Z místností lze odvodit dispozici i celkovou užitnou plochu."@cs, "A room of the property. Layout and total usable area can be derived from rooms."@en ;
    rdfs:subClassOf schema:Room ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:Equipment
    a owl:Class ;
    rdfs:label "Equipment"@en ;
    rdfs:comment "Prvek vybavení vázaný na konkrétní místnost."@cs, "An item of equipment bound to a specific room."@en ;
    rdfs:subClassOf schema:Thing ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:UtilityNetwork
    a owl:Class ;
    rdfs:label "UtilityNetwork"@en ;
    rdfs:comment "Napojení nemovitosti na inženýrskou síť. Síť a způsob připojení jsou dvě nezávislé osy, proto dva číselníky."@cs, "Connection of the property to a utility network. Network and connection are two independent axes, hence two codelists."@en ;
    rdfs:subClassOf schema:Thing ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:Parking
    a owl:Class ;
    rdfs:label "Parking"@en ;
    rdfs:comment "Možnost parkování náležející k nemovitosti. Není modelována jako místnost, protože parkování se nezapočítává do dispozice ani užitné plochy jednotky."@cs, "A parking option belonging to the property. Not modelled as a room, because parking does not count towards the layout or usable area of the unit."@en ;
    rdfs:subClassOf schema:Thing ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:Media
    a owl:Class ;
    rdfs:label "Media"@en ;
    rdfs:comment "Multimediální prvek nabídky včetně pořadí zobrazení."@cs, "A multimedia item of the offer, including display order."@en ;
    rdfs:subClassOf schema:MediaObject ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:ExportInformation
    a owl:Class ;
    rdfs:label "ExportInformation"@en ;
    rdfs:comment "Auditní stopa umožňující párování záznamů při opakovaném importu napříč systémy."@cs, "Audit trail enabling record matching on repeated import across systems."@en ;
    rdfs:subClassOf schema:Thing ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

#======================================================================
# Properties defined by ERDIF
#======================================================================

erdif:formatVersion
    a owl:DatatypeProperty ;
    rdfs:label "formatVersion"@en ;
    rdfs:comment "Verze formátu ERDIF, podle které byl dokument vytvořen."@cs, "Version of the ERDIF format the document was created against."@en ;
    rdfs:domain erdif:Advert ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:transactionType
    a owl:ObjectProperty ;
    rdfs:label "transactionType"@en ;
    rdfs:comment "Typ transakce, které se nabídka týká."@cs, "Type of transaction the offer concerns."@en ;
    rdfs:domain erdif:Advert ;
    rdfs:range erdif-cl:TransactionType ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:contact
    a owl:ObjectProperty ;
    rdfs:label "contact"@en ;
    rdfs:comment "Kontaktní subjekt spravující nabídku."@cs, "Contact entity managing the offer."@en ;
    rdfs:domain erdif:Advert ;
    rdfs:range erdif:Contact ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:realty
    a owl:ObjectProperty ;
    rdfs:label "realty"@en ;
    rdfs:comment "Fyzická nemovitost, které se nabídka týká."@cs, "Physical property the offer concerns."@en ;
    rdfs:domain erdif:Advert ;
    rdfs:range erdif:Realty ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:price
    a owl:ObjectProperty ;
    rdfs:label "prices"@en ;
    rdfs:comment "Cenové položky nabídky."@cs, "Price items of the offer."@en ;
    rdfs:domain erdif:Advert ;
    rdfs:range erdif:Price ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:media
    a owl:ObjectProperty ;
    rdfs:label "media"@en ;
    rdfs:comment "Fotografie, videa, půdorysy a virtuální prohlídky."@cs, "Photos, videos, floor plans and virtual tours."@en ;
    rdfs:domain erdif:Advert ;
    rdfs:range erdif:Media ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:exportInformation
    a owl:ObjectProperty ;
    rdfs:label "exportInformation"@en ;
    rdfs:comment "Auditní stopa exportu."@cs, "Export audit trail."@en ;
    rdfs:domain erdif:Advert ;
    rdfs:range erdif:ExportInformation ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:priceType
    a owl:ObjectProperty ;
    rdfs:label "priceType"@en ;
    rdfs:comment "Typ cenové položky."@cs, "Type of the price item."@en ;
    rdfs:domain erdif:Price ;
    rdfs:range erdif-cl:PriceType ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:priceOnRequest
    a owl:DatatypeProperty ;
    rdfs:label "priceOnRequest"@en ;
    rdfs:comment "Příznak, že cena je k dispozici pouze na dotaz."@cs, "Flag indicating that the price is available on request only."@en ;
    rdfs:domain erdif:Price ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:negotiable
    a owl:DatatypeProperty ;
    rdfs:label "negotiable"@en ;
    rdfs:comment "Příznak, zda je cena k jednání."@cs, "Flag indicating whether the price is negotiable."@en ;
    rdfs:domain erdif:Price ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:contactType
    a owl:ObjectProperty ;
    rdfs:label "contactType"@en ;
    rdfs:comment "Typ inzerenta (makléř, kancelář, majitel)."@cs, "Type of advertiser (agent, office, owner)."@en ;
    rdfs:domain erdif:Contact ;
    rdfs:range erdif-cl:ContactType ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:realtyType
    a owl:ObjectProperty ;
    rdfs:label "realtyType"@en ;
    rdfs:comment "Druh nemovitosti."@cs, "Type of real estate."@en ;
    rdfs:domain erdif:Realty ;
    rdfs:range erdif-cl:RealtyType ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:ownershipType
    a owl:ObjectProperty ;
    rdfs:label "ownershipType"@en ;
    rdfs:comment "Forma vlastnictví."@cs, "Form of ownership."@en ;
    rdfs:domain erdif:Realty ;
    rdfs:range erdif-cl:OwnershipType ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:energyClass
    a owl:ObjectProperty ;
    rdfs:label "energyClass"@en ;
    rdfs:comment "Energetická třída podle směrnice EPBD."@cs, "Energy class per the EPBD directive."@en ;
    rdfs:domain erdif:Realty ;
    rdfs:range erdif-cl:EnergyClass ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:condition
    a owl:ObjectProperty ;
    rdfs:label "condition"@en ;
    rdfs:comment "Stav samotné nemovitosti; může se lišit od stavu budovy."@cs, "Condition of the property itself; may differ from the condition of the building."@en ;
    rdfs:domain erdif:Realty ;
    rdfs:range erdif-cl:RealtyCondition ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:plotSize
    a owl:ObjectProperty ;
    rdfs:label "plotSize"@en ;
    rdfs:comment "Plocha pozemku v m² (`MTK`)."@cs, "Area of the land plot in square metres (`MTK`)."@en ;
    rdfs:domain erdif:Realty ;
    rdfs:range schema:QuantitativeValue ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:floorLevel
    a owl:DatatypeProperty ;
    rdfs:label "floorLevel"@en ;
    rdfs:comment "Podlaží, ve kterém se jednotka nachází (0 = přízemí, záporné = podzemní)."@cs, "Floor on which the unit is located (0 = ground floor, negative = underground)."@en ;
    rdfs:domain schema:Accommodation ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:accessibility
    a owl:ObjectProperty ;
    rdfs:label "accessibility"@en ;
    rdfs:comment "Prvky bezbariérovosti nemovitosti jako celku (vstup, přístup)."@cs, "Accessibility features of the property as a whole (entrance, access)."@en ;
    rdfs:domain schema:Accommodation ;
    rdfs:range erdif-cl:AccessibilityFeature ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:location
    a owl:ObjectProperty ;
    rdfs:label "location"@en ;
    rdfs:comment "Poloha nemovitosti."@cs, "Location of the property."@en ;
    rdfs:domain erdif:Realty ;
    rdfs:range erdif:Location ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:building
    a owl:ObjectProperty ;
    rdfs:label "building"@en ;
    rdfs:comment "Budova, jejíž je nemovitost součástí nebo kterou tvoří. U pozemků se neuvádí."@cs, "Building the property is part of or consists of. Omitted for land."@en ;
    rdfs:domain erdif:Realty ;
    rdfs:range erdif:Building ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:room
    a owl:ObjectProperty ;
    rdfs:label "rooms"@en ;
    rdfs:comment "Členění nemovitosti na místnosti. Pozemky žádné nemají."@cs, "Breakdown into rooms. Land parcels have none."@en ;
    rdfs:domain erdif:Realty ;
    rdfs:range erdif:Room ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:utilityNetwork
    a owl:ObjectProperty ;
    rdfs:label "utilityNetworks"@en ;
    rdfs:comment "Napojení na inženýrské sítě."@cs, "Utility network connections."@en ;
    rdfs:domain erdif:Realty ;
    rdfs:range erdif:UtilityNetwork ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:parking
    a owl:ObjectProperty ;
    rdfs:label "parking"@en ;
    rdfs:comment "Možnosti parkování náležející k nemovitosti."@cs, "Parking options belonging to the property."@en ;
    rdfs:domain erdif:Realty ;
    rdfs:range erdif:Parking ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:localArea
    a owl:ObjectProperty ;
    rdfs:label "localArea"@en ;
    rdfs:comment "Občanská vybavenost v okolí nemovitosti (doprava, školy, parky, ...)."@cs, "Amenities in the surroundings of the property (transport, schools, parks, ...)."@en ;
    rdfs:domain erdif:Realty ;
    rdfs:range erdif:LocalArea ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:constructionType
    a owl:ObjectProperty ;
    rdfs:label "constructionType"@en ;
    rdfs:comment "Hlavní nosná konstrukce budovy."@cs, "Main load-bearing construction of the building."@en ;
    rdfs:domain erdif:Building ;
    rdfs:range erdif-cl:ConstructionType ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:lastRenovationYear
    a owl:DatatypeProperty ;
    rdfs:label "lastRenovationYear"@en ;
    rdfs:comment "Rok poslední rozsáhlé rekonstrukce budovy."@cs, "Year of the last major renovation of the building."@en ;
    rdfs:domain erdif:Building ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:floorsAboveGround
    a owl:DatatypeProperty ;
    rdfs:label "floorsAboveGround"@en ;
    rdfs:comment "Počet nadzemních podlaží včetně přízemí."@cs, "Number of above-ground floors including the ground floor."@en ;
    rdfs:domain erdif:Building ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:floorsUnderground
    a owl:DatatypeProperty ;
    rdfs:label "floorsUnderground"@en ;
    rdfs:comment "Počet podzemních podlaží."@cs, "Number of underground floors."@en ;
    rdfs:domain erdif:Building ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:elevator
    a owl:DatatypeProperty ;
    rdfs:label "elevator"@en ;
    rdfs:comment "Příznak, zda je v budově výtah."@cs, "Flag indicating whether the building has an elevator."@en ;
    rdfs:domain erdif:Building ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:globalIdentifier
    a owl:ObjectProperty ;
    rdfs:label "globalIdentifier"@en ;
    rdfs:comment "Nadnárodní prostorový identifikátor INSPIRE."@cs, "Supranational INSPIRE spatial identifier."@en ;
    rdfs:domain erdif:Location ;
    rdfs:range erdif:InspireIdentifier ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:approximateCoordinates
    a owl:DatatypeProperty ;
    rdfs:label "approximateCoordinates"@en ;
    rdfs:comment "Příznak, zda jsou souřadnice přibližné."@cs, "Flag indicating whether coordinates are approximate."@en ;
    rdfs:domain erdif:Location ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:localIdentifier
    a owl:ObjectProperty ;
    rdfs:label "localIdentifiers"@en ;
    rdfs:comment "Identifikátory národních registrů (např. RÚIAN)."@cs, "National registry identifiers (e.g. RUIAN)."@en ;
    rdfs:domain erdif:Location ;
    rdfs:range erdif:LocalIdentifier ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:inspireTheme
    a owl:DatatypeProperty ;
    rdfs:label "theme"@en ;
    rdfs:comment "Kód tématu INSPIRE: `AD` (adresy), `BU` (budovy), `CP` (katastrální parcely)."@cs, "INSPIRE theme code: `AD` (addresses), `BU` (buildings), `CP` (cadastral parcels)."@en ;
    rdfs:domain erdif:InspireIdentifier ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:inspireNamespace
    a owl:DatatypeProperty ;
    rdfs:label "namespace"@en ;
    rdfs:comment "Jmenný prostor poskytovatele dat (např. `CZ.CUZK.AD`)."@cs, "Namespace of the data provider (e.g. `CZ.CUZK.AD`)."@en ;
    rdfs:domain erdif:InspireIdentifier ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:inspireLocalId
    a owl:DatatypeProperty ;
    rdfs:label "localId"@en ;
    rdfs:comment "Identifikátor objektu v rámci jmenného prostoru."@cs, "Identifier of the object within the namespace."@en ;
    rdfs:domain erdif:InspireIdentifier ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:registry
    a owl:DatatypeProperty ;
    rdfs:label "registry"@en ;
    rdfs:comment "Název registru (např. `RUIAN`)."@cs, "Name of the registry (e.g. `RUIAN`)."@en ;
    rdfs:domain erdif:LocalIdentifier ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:registryCountry
    a owl:DatatypeProperty ;
    rdfs:label "registryCountry"@en ;
    rdfs:comment "Země registru podle ISO 3166-1 alpha-2."@cs, "Country of the registry per ISO 3166-1 alpha-2."@en ;
    rdfs:domain erdif:LocalIdentifier ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:registryLevel
    a owl:DatatypeProperty ;
    rdfs:label "registryLevel"@en ;
    rdfs:comment "Úroveň identifikovaného objektu v registru (např. `Address`, `Building`, `Parcel`)."@cs, "Level of the identified object within the registry (e.g. `Address`, `Building`, `Parcel`)."@en ;
    rdfs:domain erdif:LocalIdentifier ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:amenityType
    a owl:ObjectProperty ;
    rdfs:label "amenityType"@en ;
    rdfs:comment "Druh vybavenosti."@cs, "Type of amenity."@en ;
    rdfs:domain erdif:LocalArea ;
    rdfs:range erdif-cl:AmenityType ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:distance
    a owl:ObjectProperty ;
    rdfs:label "distance"@en ;
    rdfs:comment "Vzdálenost od nemovitosti v metrech (`MTR`)."@cs, "Distance from the property in metres (`MTR`)."@en ;
    rdfs:domain erdif:LocalArea ;
    rdfs:range schema:QuantitativeValue ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:roomType
    a owl:ObjectProperty ;
    rdfs:label "roomType"@en ;
    rdfs:comment "Druh místnosti."@cs, "Type of room."@en ;
    rdfs:domain erdif:Room ;
    rdfs:range erdif-cl:RoomType ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:equipment
    a owl:ObjectProperty ;
    rdfs:label "equipment"@en ;
    rdfs:comment "Vybavení místnosti. Vázáno na místnost, nikoli na celou nemovitost."@cs, "Room equipment. Bound to the room, not the whole property."@en ;
    rdfs:domain erdif:Room ;
    rdfs:range erdif:Equipment ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:equipmentType
    a owl:ObjectProperty ;
    rdfs:label "equipmentType"@en ;
    rdfs:comment "Kategorie vybavení."@cs, "Category of equipment."@en ;
    rdfs:domain erdif:Equipment ;
    rdfs:range erdif-cl:EquipmentType ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:network
    a owl:ObjectProperty ;
    rdfs:label "network"@en ;
    rdfs:comment "Druh inženýrské sítě."@cs, "Type of utility network."@en ;
    rdfs:domain erdif:UtilityNetwork ;
    rdfs:range erdif-cl:UtilityNetwork ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:connection
    a owl:ObjectProperty ;
    rdfs:label "connection"@en ;
    rdfs:comment "Způsob napojení na danou síť."@cs, "Means of connection to the given network."@en ;
    rdfs:domain erdif:UtilityNetwork ;
    rdfs:range erdif-cl:UtilityConnection ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:parkingType
    a owl:ObjectProperty ;
    rdfs:label "parkingType"@en ;
    rdfs:comment "Druh parkování."@cs, "Type of parking."@en ;
    rdfs:domain erdif:Parking ;
    rdfs:range erdif-cl:ParkingType ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:count
    a owl:DatatypeProperty ;
    rdfs:label "count"@en ;
    rdfs:comment "Počet stání tohoto druhu. Výchozí hodnota je 1."@cs, "Number of spaces of this type. Defaults to 1."@en ;
    rdfs:domain erdif:Parking ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:includedInPrice
    a owl:DatatypeProperty ;
    rdfs:label "includedInPrice"@en ;
    rdfs:comment "Příznak, zda je parkování zahrnuto v hlavní ceně."@cs, "Flag indicating whether parking is included in the main price."@en ;
    rdfs:domain erdif:Parking ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:mediaType
    a owl:ObjectProperty ;
    rdfs:label "mediaType"@en ;
    rdfs:comment "Druh média."@cs, "Type of media."@en ;
    rdfs:domain erdif:Media ;
    rdfs:range erdif-cl:MediaType ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:position
    a owl:DatatypeProperty ;
    rdfs:label "position"@en ;
    rdfs:comment "Pořadí zobrazení."@cs, "Display order."@en ;
    rdfs:domain erdif:Media ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:sourceSystem
    a owl:DatatypeProperty ;
    rdfs:label "sourceSystem"@en ;
    rdfs:comment "Identifikace zdrojového softwaru."@cs, "Identification of the source software."@en ;
    rdfs:domain erdif:ExportInformation ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:sourceAdvertId
    a owl:DatatypeProperty ;
    rdfs:label "sourceAdvertId"@en ;
    rdfs:comment "Identifikátor inzerátu ve zdrojovém systému."@cs, "Advert identifier within the source system."@en ;
    rdfs:domain erdif:ExportInformation ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

erdif:exportedAt
    a owl:DatatypeProperty ;
    rdfs:label "exportedAt"@en ;
    rdfs:comment "Časová značka exportu."@cs, "Timestamp of the export."@en ;
    rdfs:domain erdif:ExportInformation ;
    rdfs:range xsd:dateTime ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

#======================================================================
# schema.org terms reused by ERDIF
# (declared with schema:domainIncludes / schema:rangeIncludes, which do
#  not constrain the terms; the comments are ERDIF usage notes)
#======================================================================

schema:identifier
    a rdf:Property ;
    rdfs:label "identifier"@en ;
    rdfs:comment "Identifikátor inzerátu v rámci vydávajícího systému."@cs, "Identifier of the advert within the issuing system."@en ;
    schema:domainIncludes schema:Thing ;
    schema:rangeIncludes xsd:string .

schema:datePosted
    a rdf:Property ;
    rdfs:label "datePosted"@en ;
    rdfs:comment "Okamžik zveřejnění nabídky."@cs, "Moment the offer was published."@en ;
    schema:domainIncludes erdif:Advert ;
    schema:rangeIncludes xsd:dateTime .

schema:description
    a rdf:Property ;
    rdfs:label "description"@en ;
    rdfs:comment "Marketingový text nabídky v jazykových mutacích. Alespoň jeden jazyk je povinný."@cs, "Marketing text of the offer in language variants. At least one language is required."@en ;
    schema:domainIncludes erdif:Advert ;
    schema:rangeIncludes rdf:langString .

schema:price
    a rdf:Property ;
    rdfs:label "price"@en ;
    rdfs:comment "Číselná hodnota ceny. Smí chybět jen tehdy, když je `priceOnRequest` true."@cs, "Numeric value of the price. May be omitted only when `priceOnRequest` is true."@en ;
    schema:domainIncludes erdif:Price ;
    schema:rangeIncludes xsd:decimal .

schema:priceCurrency
    a rdf:Property ;
    rdfs:label "priceCurrency"@en ;
    rdfs:comment "Měna podle ISO 4217."@cs, "Currency per ISO 4217."@en ;
    schema:domainIncludes erdif:Price ;
    schema:rangeIncludes xsd:string .

schema:unitCode
    a rdf:Property ;
    rdfs:label "unitCode"@en ;
    rdfs:comment "Měrná jednotka podle UN/CEFACT (např. MON za měsíc, MTK za m²)."@cs, "Unit of measure per UN/CEFACT (e.g. MON per month, MTK per sqm)."@en ;
    schema:domainIncludes schema:Thing ;
    schema:rangeIncludes xsd:string .

schema:name
    a rdf:Property ;
    rdfs:label "name"@en ;
    rdfs:comment "Jméno subjektu."@cs, "Name of the entity."@en ;
    schema:domainIncludes schema:Thing ;
    schema:rangeIncludes rdf:langString .

schema:email
    a rdf:Property ;
    rdfs:label "email"@en ;
    rdfs:comment "Kontaktní e-mail."@cs, "Contact e-mail."@en ;
    schema:domainIncludes erdif:Contact ;
    schema:rangeIncludes xsd:string .

schema:telephone
    a rdf:Property ;
    rdfs:label "telephone"@en ;
    rdfs:comment "Kontaktní telefon v mezinárodním formátu."@cs, "Contact phone in international format."@en ;
    schema:domainIncludes erdif:Contact ;
    schema:rangeIncludes xsd:string .

schema:floorSize
    a rdf:Property ;
    rdfs:label "floorSize"@en ;
    rdfs:comment "Celková podlahová plocha stavby nebo jednotky v m² (`MTK`)."@cs, "Total floor area of the building or unit in square metres (`MTK`)."@en ;
    schema:domainIncludes schema:Accommodation ;
    schema:rangeIncludes schema:QuantitativeValue .

schema:yearBuilt
    a rdf:Property ;
    rdfs:label "yearBuilt"@en ;
    rdfs:comment "Rok dokončení budovy."@cs, "Year the building was completed."@en ;
    schema:domainIncludes erdif:Building ;
    schema:rangeIncludes xsd:integer .

schema:geo
    a rdf:Property ;
    rdfs:label "geo"@en ;
    rdfs:comment "Souřadnice WGS 84. Povinný záložní údaj."@cs, "WGS 84 coordinates. Mandatory fallback."@en ;
    schema:domainIncludes erdif:Location ;
    schema:rangeIncludes schema:GeoCoordinates .

schema:address
    a rdf:Property ;
    rdfs:label "address"@en ;
    rdfs:comment "Poštovní adresa v lokálním formátu."@cs, "Postal address in local format."@en ;
    schema:domainIncludes erdif:Location ;
    schema:rangeIncludes schema:PostalAddress .

schema:contentUrl
    a rdf:Property ;
    rdfs:label "contentUrl"@en ;
    rdfs:comment "Adresa média."@cs, "URL of the media item."@en ;
    schema:domainIncludes erdif:Media ;
    schema:rangeIncludes xsd:anyURI .

schema:caption
    a rdf:Property ;
    rdfs:label "caption"@en ;
    rdfs:comment "Popisek média v jazykových mutacích."@cs, "Caption of the media item in language variants."@en ;
    schema:domainIncludes erdif:Media ;
    schema:rangeIncludes rdf:langString .

schema:value
    a rdf:Property ;
    rdfs:label "value"@en ;
    rdfs:comment "Číselná hodnota."@cs, "The numeric value."@en ;
    schema:domainIncludes schema:QuantitativeValue ;
    schema:rangeIncludes xsd:decimal .

schema:latitude
    a rdf:Property ;
    rdfs:label "latitude"@en ;
    rdfs:comment "Zeměpisná šířka (WGS 84)."@cs, "WGS 84 latitude."@en ;
    schema:domainIncludes schema:GeoCoordinates ;
    schema:rangeIncludes xsd:double .

schema:longitude
    a rdf:Property ;
    rdfs:label "longitude"@en ;
    rdfs:comment "Zeměpisná délka (WGS 84)."@cs, "WGS 84 longitude."@en ;
    schema:domainIncludes schema:GeoCoordinates ;
    schema:rangeIncludes xsd:double .

schema:streetAddress
    a rdf:Property ;
    rdfs:label "streetAddress"@en ;
    rdfs:comment "Ulice a číslo domu."@cs, "Street and house number."@en ;
    schema:domainIncludes schema:PostalAddress ;
    schema:rangeIncludes xsd:string .

schema:addressLocality
    a rdf:Property ;
    rdfs:label "addressLocality"@en ;
    rdfs:comment "Obec."@cs, "Municipality."@en ;
    schema:domainIncludes schema:PostalAddress ;
    schema:rangeIncludes xsd:string .

schema:addressRegion
    a rdf:Property ;
    rdfs:label "addressRegion"@en ;
    rdfs:comment "Region."@cs, "Region."@en ;
    schema:domainIncludes schema:PostalAddress ;
    schema:rangeIncludes xsd:string .

schema:postalCode
    a rdf:Property ;
    rdfs:label "postalCode"@en ;
    rdfs:comment "PSČ."@cs, "Postal code."@en ;
    schema:domainIncludes schema:PostalAddress ;
    schema:rangeIncludes xsd:string .

schema:addressCountry
    a rdf:Property ;
    rdfs:label "addressCountry"@en ;
    rdfs:comment "Kód země podle ISO 3166-1 alpha-2."@cs, "ISO 3166-1 alpha-2 country code."@en ;
    schema:domainIncludes schema:PostalAddress ;
    schema:rangeIncludes xsd:string .

schema:QuantitativeValue
    a owl:Class ;
    rdfs:label "Quantitative value"@en ;
    rdfs:comment "schema:QuantitativeValue — a number with a UN/CEFACT Recommendation 20 unit code."@en ;
    rdfs:subClassOf schema:Thing ;
    rdfs:isDefinedBy <https://schema.org/> .

schema:GeoCoordinates
    a owl:Class ;
    rdfs:label "Geo coordinates"@en ;
    rdfs:comment "schema:GeoCoordinates — a WGS 84 point."@en ;
    rdfs:subClassOf schema:Thing ;
    rdfs:isDefinedBy <https://schema.org/> .

schema:PostalAddress
    a owl:Class ;
    rdfs:label "Postal address"@en ;
    rdfs:comment "schema:PostalAddress — the postal address in the local format."@en ;
    rdfs:subClassOf schema:Thing ;
    rdfs:isDefinedBy <https://schema.org/> .

schema:RealEstateListing
    a owl:Class ;
    rdfs:label "Real estate listing"@en ;
    rdfs:subClassOf schema:Thing ;
    rdfs:isDefinedBy <https://schema.org/> .

schema:Thing
    a owl:Class ;
    rdfs:label "Thing"@en ;
    rdfs:isDefinedBy <https://schema.org/> .

schema:PriceSpecification
    a owl:Class ;
    rdfs:label "Price specification"@en ;
    rdfs:subClassOf schema:Thing ;
    rdfs:isDefinedBy <https://schema.org/> .

schema:Person
    a owl:Class ;
    rdfs:label "Person"@en ;
    rdfs:subClassOf schema:Thing ;
    rdfs:isDefinedBy <https://schema.org/> .

schema:Organization
    a owl:Class ;
    rdfs:label "Organization"@en ;
    rdfs:subClassOf schema:Thing ;
    rdfs:isDefinedBy <https://schema.org/> .

schema:Accommodation
    a owl:Class ;
    rdfs:label "Accommodation"@en ;
    rdfs:subClassOf schema:Place ;
    rdfs:isDefinedBy <https://schema.org/> .

schema:Place
    a owl:Class ;
    rdfs:label "Place"@en ;
    rdfs:subClassOf schema:Thing ;
    rdfs:isDefinedBy <https://schema.org/> .

schema:Room
    a owl:Class ;
    rdfs:label "Room"@en ;
    rdfs:subClassOf schema:Accommodation ;
    rdfs:isDefinedBy <https://schema.org/> .

schema:MediaObject
    a owl:Class ;
    rdfs:label "Media object"@en ;
    rdfs:subClassOf schema:Thing ;
    rdfs:isDefinedBy <https://schema.org/> .

#======================================================================
# Codelists — each is a class whose instances are skos:Concepts
#======================================================================

erdif-cl:AccessibilityFeature
    a owl:Class, skos:ConceptScheme ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "AccessibilityFeature"@en ;
    rdfs:comment "Prvek bezbariérovosti. `appliesTo` uvádí úrovně (Realty, Room), na kterých lze hodnotu použít."@cs, "Accessibility feature. `appliesTo` lists the levels (Realty, Room) the value may be used on."@en ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

<https://erdif-org.github.io/erdif-spec/codelist/v1/AccessibilityFeature#BarrierFree>
    a skos:Concept, erdif-cl:AccessibilityFeature ;
    skos:inScheme erdif-cl:AccessibilityFeature ;
    skos:notation "BarrierFree" ;
    skos:prefLabel "Bezbariérová"@cs, "Barrier-free"@en ;
    skos:definition "Plně bezbariérová podle národního předpisu (v ČR vyhláška č. 398/2009 Sb.)."@cs, "Fully accessible according to the national regulation (e.g. Decree 398/2009 Coll. in CZ)."@en .

<https://erdif-org.github.io/erdif-spec/codelist/v1/AccessibilityFeature#StepFreeEntrance>
    a skos:Concept, erdif-cl:AccessibilityFeature ;
    skos:inScheme erdif-cl:AccessibilityFeature ;
    skos:notation "StepFreeEntrance" ;
    skos:prefLabel "Bezbariérový vstup"@cs, "Step-free entrance"@en ;
    skos:definition "Vstup bez schodů nebo s rampou."@cs, "Entrance without steps or with a ramp."@en .

<https://erdif-org.github.io/erdif-spec/codelist/v1/AccessibilityFeature#ElevatorAccess>
    a skos:Concept, erdif-cl:AccessibilityFeature ;
    skos:inScheme erdif-cl:AccessibilityFeature ;
    skos:notation "ElevatorAccess" ;
    skos:prefLabel "Přístup výtahem"@cs, "Elevator access"@en ;
    skos:definition "Jednotka je dosažitelná výtahem."@cs, "The unit is reachable by an elevator."@en .

<https://erdif-org.github.io/erdif-spec/codelist/v1/AccessibilityFeature#StairLift>
    a skos:Concept, erdif-cl:AccessibilityFeature ;
    skos:inScheme erdif-cl:AccessibilityFeature ;
    skos:notation "StairLift" ;
    skos:prefLabel "Schodišťová plošina"@cs, "Stair lift"@en ;
    skos:definition "Schodišťová nebo zdvižná plošina."@cs, "Stair lift or platform lift."@en .

<https://erdif-org.github.io/erdif-spec/codelist/v1/AccessibilityFeature#WideDoorways>
    a skos:Concept, erdif-cl:AccessibilityFeature ;
    skos:inScheme erdif-cl:AccessibilityFeature ;
    skos:notation "WideDoorways" ;
    skos:prefLabel "Rozšířené dveře"@cs, "Wide doorways"@en ;
    skos:definition "Dveře dostatečně široké pro invalidní vozík."@cs, "Doorways wide enough for a wheelchair."@en .

<https://erdif-org.github.io/erdif-spec/codelist/v1/AccessibilityFeature#ThresholdFree>
    a skos:Concept, erdif-cl:AccessibilityFeature ;
    skos:inScheme erdif-cl:AccessibilityFeature ;
    skos:notation "ThresholdFree" ;
    skos:prefLabel "Bez prahů"@cs, "Threshold-free"@en ;
    skos:definition "Bez prahů mezi místnostmi."@cs, "No thresholds between rooms."@en .

<https://erdif-org.github.io/erdif-spec/codelist/v1/AccessibilityFeature#WheelchairTurningSpace>
    a skos:Concept, erdif-cl:AccessibilityFeature ;
    skos:inScheme erdif-cl:AccessibilityFeature ;
    skos:notation "WheelchairTurningSpace" ;
    skos:prefLabel "Otočný prostor pro vozík"@cs, "Wheelchair turning space"@en ;
    skos:definition "Dostatečný prostor pro otočení invalidního vozíku."@cs, "Enough space for a wheelchair to turn."@en .

<https://erdif-org.github.io/erdif-spec/codelist/v1/AccessibilityFeature#WalkInShower>
    a skos:Concept, erdif-cl:AccessibilityFeature ;
    skos:inScheme erdif-cl:AccessibilityFeature ;
    skos:notation "WalkInShower" ;
    skos:prefLabel "Bezbariérový sprchový kout"@cs, "Walk-in shower"@en ;
    skos:definition "Sprchový kout bez vaničky a obruby."@cs, "Level-access shower without a tray edge."@en .

<https://erdif-org.github.io/erdif-spec/codelist/v1/AccessibilityFeature#GrabBars>
    a skos:Concept, erdif-cl:AccessibilityFeature ;
    skos:inScheme erdif-cl:AccessibilityFeature ;
    skos:notation "GrabBars" ;
    skos:prefLabel "Madla"@cs, "Grab bars"@en ;
    skos:definition "Opěrná madla u WC, vany nebo sprchy."@cs, "Support grab bars at the toilet, bath or shower."@en .

erdif-cl:AmenityType
    a owl:Class, skos:ConceptScheme ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "AmenityType"@en ;
    rdfs:comment "Druh občanské vybavenosti v okolí nemovitosti."@cs, "Type of amenity in the surroundings of the property."@en ;
    rdfs:isDefinedBy <https://erdif-org.github.io/erdif-spec/ns/v1> .

<https://erdif-org.github.io/erdif-spec/codelist/v1/AmenityType#BusStop>
    a skos:Concept, erdif-cl:AmenityType ;
    skos:inScheme erdif-cl:AmenityType ;
    skos:notation "BusStop" ;
    skos:prefLabel "Autobusová zastávka"@cs, "Bus stop"@en ;
    skos:definition "Zastávka městské nebo linkové autobusové dopravy."@cs, "Public bus stop."@en .

<https://erdif-org.github.io/erdif-spec/codelist/v1/AmenityType#TramStop>
    a skos:Concept, erdif-cl:AmenityType ;
    skos:inScheme erdif-cl:AmenityType ;
    skos:notation "TramStop" ;
    skos:prefLabel "Tramvajová zastávka"@cs, "Tram stop"@en ;
    skos:definition "Zastávka tramvaje."@cs, "Public tram stop."@en .

<https://erdif-org.github.io/erdif-spec/codelist/v1/AmenityType#MetroStation>
    a skos:Concept, erdif-cl:AmenityType ;
    skos:inScheme erdif-cl:AmenityType ;
    skos:notation "MetroStation" ;
    skos:prefLabel "Stanice metra"@cs, "Metro station"@en ;
    skos:definition "Stanice metra."@cs, "Underground or metro station."@en .

<https://erdif-org.github.io/erdif-spec/codelist/v1/AmenityType#TrainStation>
    a skos:Concept, erdif-cl:AmenityType ;
    skos:inScheme erdif-cl:AmenityType ;
    skos:notation "TrainStation" ;
    skos:prefLabel "Vlakové nádraží"@cs, "Train station"@en ;
    skos:definition "Železniční stanice nebo zastávka."@cs, "Railway station or stop."@en .

<https://erdif-org.github.io/erdif-spec/codelist/v1/AmenityType#ParkingLot>
    a skos:Concept, erdif-cl:AmenityType ;
    skos:inScheme erdif-cl:AmenityType ;
    skos:notation "ParkingLot" ;
    skos:prefLabel "Veřejné parkoviště"@cs, "Public parking"@en ;
    skos:definition "Veřejné parkoviště."@cs, "Public car park."@en .

<https://erdif-org.github.io/erdif-spec/codelist/v1/AmenityType#Kindergarten>
    a skos:Concept, erdif-cl:AmenityType ;
    skos:inScheme erdif-cl:AmenityType ;
    skos:notation "Kindergarten" ;
    skos:prefLabel "Mateřská škola"@cs, "Kindergarten"@en ;
    skos:definition "Zařízení předškolního vzdělávání."@cs, "Pre-school education facility."@en .

<https://erdif-org.github.io/erdif-spec/codelist/v1/AmenityType#School>
    a skos:Concept, erdif-cl:AmenityType ;
    skos:inScheme erdif-cl:AmenityType ;
    skos:notation "School" ;
    skos:prefLabel "Škola"@cs, "School"@en ;
    skos:definition "Základní nebo střední škola."@cs, "Primary or secondary school."@en .

<https://erdif-org.github.io/erdif-spec/codelist/v1/AmenityType#University>
    a skos:Concept, erdif-cl:AmenityType ;
    skos:inScheme erdif-cl:AmenityType ;
    skos:notation "University" ;
    skos:prefLabel "Vysoká škola"@cs, "University"@en ;
    skos:definition "Vysoká škola nebo univerzita."@cs, "Higher education institution."@en .

<https://erdif-org.github.io/erdif-spec/codelist/v1/AmenityType#Shop>
    a skos:Concept, erdif-cl:AmenityType ;
    skos:inScheme erdif-cl:AmenityType ;
    skos:notation "Shop" ;
    skos:prefLabel "Obchod"@cs, "Shop"@en ;
    skos:definition "Maloobchodní prodejna."@cs, "Retail shop."@en .

<https://erdif-org.github.io/erdif-spec/codelist/v1/AmenityType#Supermarket>
    a skos:Concept, erdif-cl:AmenityType ;
    skos:inScheme erdif-cl:AmenityType ;
    skos:notation "Supermarket" ;
    skos:prefLabel "Supermarket"@cs, "Supermarket"@en ;
    skos:definition "Potravinový supermarket."@cs, "Grocery supermarket."@en .

<https://erdif-org.github.io/erdif-spec/codelist/v1/AmenityType#PostOffice>
    a skos:Concept, erdif-cl:AmenityType ;
